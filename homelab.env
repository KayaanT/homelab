# Edit these, then run: ./scripts/configure.sh
# Placeholders are substituted across the repo in place.

DOMAIN=lab.example.com          # your Cloudflare zone, e.g. lab.kayaan.dev
NODE_IP=192.168.1.50            # static IP of the homelab box
NODE_NAME=homelab               # must match `kubectl get nodes` output
LB_RANGE_START=192.168.1.240    # outside your router's DHCP scope
LB_RANGE_END=192.168.1.250
GITHUB_REPO=https://github.com/KayaanT/homelab.git
ACME_EMAIL=you@example.com
TWINGATE_NETWORK=yourorg            # the slug in yourorg.twingate.com
NIC_REGEX=^en.*                 # `ip -br link` -> the wired interface
